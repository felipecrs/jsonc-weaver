{
  "name": "@felipecrs/jsonc-weaver",
  "version": "0.0.0-semantic-release",
  "license": "MIT",
  "exports": "./main.ts",
  "tasks": {
    "lint": "deno fmt --check && deno check --doc && deno lint",
    "test": {
      "command": "deno test --allow-read=fixtures",
      "dependencies": ["lint"]
    },
    "bench": "deno bench --allow-read=fixtures",
    "build-npm": "deno run -A scripts/build_npm.ts"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@david/jsonc-morph": "jsr:@david/jsonc-morph@^0.3.5",
    "@deno/dnt": "jsr:@deno/dnt@^0.43.1",
    "@hexagon/proper-tags": "jsr:@hexagon/proper-tags@^2.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "semantic-release": "npm:semantic-release@^25.0.8",
    "@sebbo2002/semantic-release-jsr": "npm:@sebbo2002/semantic-release-jsr@^4.0.2",
    "conventional-changelog-conventionalcommits": "npm:conventional-changelog-conventionalcommits@^10.2.1"
  },
  "minimumDependencyAge": {
    "exclude": [
      "jsr:@deno/dnt"
    ]
  },
  "publish": {
    "exclude": [
      "*",
      ".*",
      "!main.ts",
      "!LICENSE",
      "!README.md"
    ]
  },
  "fmt": {
    "exclude": [
      "fixtures/**/*.jsonc"
    ]
  },
  "exclude": [
    "npm",
    "node_modules"
  ]
}
